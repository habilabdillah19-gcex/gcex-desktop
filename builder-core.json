{
  "appId": "com.gcex.core",
  "productName": "Core-Ex",
  "copyright": "Copyright © 2026 Habil Abdillah",
  "extraMetadata": {
    "version": "0.21.1",
    "name": "gcex-core",
    "productName": "Core-Ex",
    "description": "Core-Ex (Core Excellence) - dokumentasi & interpretasi foto core box dengan AI lokal (offline), keluarga GC-Ex",
    "gcex": {
      "page": "app-core/index.html",
      "title": "Core-Ex",
      "icon": "build/icon-core.ico",
      "theme": "core"
    }
  },
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "electron/**/*",
    "app-core/**/*",
    "package.json",
    "build/icon*.ico"
  ],
  "extraResources": [
    {
      "from": "dist-backend/gcex-backend",
      "to": "backend",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "legal",
      "to": "legal",
      "filter": [
        "*.txt",
        "*.html"
      ]
    },
    {
      "from": "docs",
      "to": "docs",
      "filter": [
        "PANDUAN_CORE.html"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "build/icon-core.ico",
    "artifactName": "Core-Ex-Setup-${version}.${ext}",
    "legalTrademarks": "Core-Ex, Core Excellence dan GC-Ex adalah nama produk milik Habil Abdillah"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Core-Ex",
    "uninstallDisplayName": "Core-Ex ${version}",
    "license": "legal/SYARAT_PENGGUNAAN.txt"
  },
  "electronFuses": {
    "runAsNode": false,
    "enableCookieEncryption": true,
    "enableNodeOptionsEnvironmentVariable": false,
    "enableNodeCliInspectArguments": false,
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "asar": true,
  "publish": null
}
