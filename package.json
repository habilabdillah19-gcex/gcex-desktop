{
  "name": "gcex-desktop",
  "productName": "GC-Ex",
  "version": "0.24.35",
  "description": "GC-Ex Grade Control Excellence - aplikasi desktop (Block Model, Drillhole & DB-Ex)",
  "main": "electron/main.js",
  "author": "Habil Abdillah",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:dh": "electron-builder --config builder-dh.json --win nsis --x64 --publish never",
    "dist:core": "electron-builder --config builder-core.json --win nsis --x64 --publish never",
    "start:core": "set GCEX_APP=core&& electron ."
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.gcex.desktop",
    "productName": "GC-Ex",
    "copyright": "Copyright © 2026 Habil Abdillah",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json",
      "build/icon*.ico"
    ],
    "extraResources": [
      {
        "from": "dist-backend/gcex-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "legal",
        "to": "legal",
        "filter": [
          "*.txt",
          "*.html"
        ]
      },
      {
        "from": "docs/tutorial-gcex/data",
        "to": "data-latihan",
        "filter": [
          "SIM_BM_GC_kadar.csv",
          "SIM_pit_fase1.dxf",
          "SIM_pit_fase2.dxf",
          "SIM_topo_akhir_juni.dxf",
          "SIM_topo_akhir_juli.dxf"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "GC-Ex-Setup-${version}.${ext}",
      "legalTrademarks": "GC-Ex dan Grade Control Excellence adalah nama produk milik Habil Abdillah"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GC-Ex",
      "uninstallDisplayName": "GC-Ex ${version}",
      "license": "legal/SYARAT_PENGGUNAAN.txt"
    },
    "fileAssociations": [
      {
        "ext": "prj",
        "name": "GC-Ex Block Model Project",
        "description": "Proyek GC-Ex Block Model",
        "icon": "icon.ico",
        "role": "Editor"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "asar": true,
    "publish": null
  },
  "gcex": {
    "page": "app/index.html",
    "title": "GC-Ex Block Model",
    "icon": "build/icon.ico",
    "theme": "bm"
  }
}
